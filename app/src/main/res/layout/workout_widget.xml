<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="#252C36">
 <TextView android:id="@+id/widget_brand" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="rwun / YOUR OWN PACE" android:textColor="#48D8C1" android:textSize="12sp" android:textStyle="bold"/>
 <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your next workout" android:textColor="#E4E9F1" android:textSize="20sp" android:textStyle="bold"/>
 <TextView android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="Open your plan" android:textColor="#A5AFBF" android:textSize="14sp"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
  <Button android:id="@+id/widget_plan" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="View plan" android:textAllCaps="false"/>
  <Button android:id="@+id/widget_run" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Record" android:textAllCaps="false"/>
 </LinearLayout>
</LinearLayout>
